# ---------------------------------------------------------------------------
# Agent Conductor daemon configuration. Copy to `.env` and adjust.
# All values are optional; the defaults below match a standard local setup.
# ---------------------------------------------------------------------------

# cmux Unix Domain Socket. Debug builds of cmux use /tmp/cmux-debug.sock.
CMUX_SOCKET_PATH=/tmp/cmux.sock

# Chrome DevTools Protocol port. Chrome must be started with
#   /Applications/Google\ Chrome.app/Contents/MacOS/Google\ Chrome --remote-debugging-port=9222
CDP_PORT=9222

# WebSocket server the React Control Tower connects to.
CONDUCTOR_WS_HOST=127.0.0.1
CONDUCTOR_WS_PORT=8787

# Snapshot broadcast cadence in milliseconds (spec: 1000ms).
SNAPSHOT_INTERVAL_MS=1000

# --- Swarm pipeline: local llama-server worker (Tier 3 LOCAL_CODEGEN) ---
LLAMA_HOST=127.0.0.1
LLAMA_PORT=8080

# --- Swarm pipeline: cloud worker (Tier 3 GEMINI_COMPLEX_UI) ---
# Left blank on purpose; wire your own provider key in via the environment.
GEMINI_API_KEY=

# Log verbosity: error | warn | info | debug
LOG_LEVEL=info
