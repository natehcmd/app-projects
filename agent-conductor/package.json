{
  "name": "agent-conductor",
  "version": "0.1.0",
  "private": true,
  "description": "Agent Conductor (Cmux Control Tower) — workspace orchestrator and multi-agent execution pipeline for macOS. Coordinates cmux terminal surfaces, Chrome tabs, local dev processes and local LLM runtime state.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "daemon": "tsx watch src/daemon/index.ts",
    "daemon:once": "tsx src/daemon/index.ts",
    "build:daemon": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.ui.json --noEmit",
    "ui:dev": "vite",
    "ui:build": "vite build",
    "ui:preview": "vite preview"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  }
}
