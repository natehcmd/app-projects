# Copy this file to .env and fill in real values (.env is gitignored, never commit it).

# Plaid — plaid.com/signup is free; Team Settings → Keys gives you Sandbox
# credentials immediately, no approval needed. Production (real bank linking)
# requires a separate application afterward.
PLAID_CLIENT_ID=
PLAID_SECRET=
# One of: sandbox, development, production
PLAID_ENV=sandbox

# Gusto: not pursued (2026-08-25) — Nate is an employee, not an admin, at the
# company whose Gusto he'd want hours from. Gusto's API is OAuth against an
# employer's account, authorized by that account's admin — not something an
# employee can self-authorize for personal use. He uses Gusto's own employee
# app directly for hours/pay stubs instead. Don't re-attempt this integration
# without that fact changing.
